	partition 'Календарь' = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2022, 1, 1), DATE(2022, 12, 31)),
				    "Год", YEAR([Date]),
				    "Номер месяца", MONTH([Date]),
				    "Месяц", SWITCH(MONTH([Date]), 1, "Январь", 2, "Февраль", 3, "Март", 4, "Апрель", 5, "Май", 6, "Июнь", 7, "Июль", 8, "Август", 9, "Сентябрь", 10, "Октябрь", 11, "Ноябрь", "Декабрь"),
				    "Квартал", "Кв. " & QUARTER([Date]),
				    "Неделя", WEEKNUM([Date], 2)
				)

	annotation PBI_Id = d1bd45ce0119441db998255aab207c38
