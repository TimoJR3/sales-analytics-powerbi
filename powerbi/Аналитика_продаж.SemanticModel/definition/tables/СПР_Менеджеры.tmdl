table 'СПР_Менеджеры'
	lineageTag: dcd058b5-87f9-471f-a587-706b840a23d9

	column 'Регион'
		dataType: string
		dataCategory: StateOrProvince
		lineageTag: cd299b19-e4c9-4639-9b01-63d4f5e4065c
		summarizeBy: none
		sourceColumn: Регион

		annotation SummarizationSetBy = Automatic

	column 'Менеджер'
		dataType: string
		lineageTag: 78a59aa2-d167-4fba-98af-2b901719eb1a
		summarizeBy: none
		sourceColumn: Менеджер

		annotation SummarizationSetBy = Automatic

	partition 'СПР_Менеджеры' = m
		mode: import
		source =
				let
				    ЧислоИз = (x) => if x = null then null else if Value.Is(x, type number) then x else Number.From(Text.Remove(Text.From(x), {" ", "#(00A0)", "#(202F)"}), "en-US"),
				    ТекстИз = (x) => if x = null then null else Text.Trim(Text.From(x)),
				    Лист = #"Источник_Excel"{[Item="СПР_Менеджеры",Kind="Sheet"]}[Data],
				    Выбор = Table.SelectColumns(Лист, {"Регион", "Менеджер"}),
				    Типы = Table.TransformColumns(Выбор, {{"Регион", ТекстИз, type text}, {"Менеджер", ТекстИз, type text}}),
				    Пустые = Table.SelectRows(Типы, each [Регион] <> null and [Регион] <> ""),
				    Уник = Table.Distinct(Пустые, {"Регион", Comparer.OrdinalIgnoreCase})
				in
				    Уник

	annotation PBI_ResultType = Table
