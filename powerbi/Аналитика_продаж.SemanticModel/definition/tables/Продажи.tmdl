	column 'Дата заказа'
		dataType: dateTime
		formatString: dd.MM.yyyy
		lineageTag: 16b6b9c9-8407-44d6-b39c-e97254fa3516
		summarizeBy: none
		sourceColumn: Дата заказа

		annotation SummarizationSetBy = Automatic

	partition 'Продажи' = m
		mode: import
		source =
				let
				    ЧислоИз = (x) => if x = null then null else if Value.Is(x, type number) then x else Number.From(Text.Remove(Text.From(x), {" ", "#(00A0)", "#(202F)"}), "en-US"),
				    ТекстИз = (x) => if x = null then null else Text.Trim(Text.From(x)),
				    Лист = #"Источник_Excel"{[Item="Продажи",Kind="Sheet"]}[Data],
				    Выбор = Table.SelectColumns(Лист, {"Order_ID", "Приоритет", "Количество", "Выручка", "Метод доставки", "Прибыль", "Покупатель", "Регион", "Продукт", "Упаковка продукта"}),
				    Числа = Table.TransformColumns(Выбор, {{"Order_ID", each Int64.From(ЧислоИз(_)), Int64.Type}, {"Количество", each Int64.From(ЧислоИз(_)), Int64.Type}, {"Выручка", ЧислоИз, type number}, {"Прибыль", ЧислоИз, type number}}),
				    Текст = Table.TransformColumns(Числа, {{"Приоритет", ТекстИз, type text}, {"Метод доставки", ТекстИз, type text}, {"Покупатель", ТекстИз, type text}, {"Регион", ТекстИз, type text}, {"Продукт", ТекстИз, type text}, {"Упаковка продукта", ТекстИз, type text}}),
				    Пустые = Table.SelectRows(Текст, each [Order_ID] <> null and [Выручка] <> null),
				    СДатой = Table.NestedJoin(Пустые, {"Order_ID"}, #"СПР_даты", {"Order_ID"}, "Д", JoinKind.LeftOuter),
				    Развернуть = Table.ExpandTableColumn(СДатой, "Д", {"Дата"}, {"Дата заказа"}),
				    Итог = Table.TransformColumnTypes(Развернуть, {{"Дата заказа", type date}})
				in
				    Итог

	annotation PBI_ResultType = Table
